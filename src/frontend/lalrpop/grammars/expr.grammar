pub Expr: Box<Expr<'input>> =
{
 Binary,
};

Call: Box<Expr<'input>> =
{
  <s1: @L> <fun: "identifier"> <e1: @R> <s2: @L> "(" <e: Comma<Expr>> ")" <e2: @R> =>
  	{
	  Box::new(Expr::
	  Call(Node::new(s1..e1,fun),
	  Node::new(s2..e2,e)))
	},
};

Binary: Box<Expr<'input>> =
{
  <lhs: Expr> <start: @L> "+" <end: @R> <rhs: Factor> =>
  	Box::new(Expr::Binary(lhs,Binop::Plus(Node::new(start..end,())),rhs)),
  <lhs: Expr> <start: @L> "-" <end: @R> <rhs: Factor> =>
  	Box::new(Expr::Binary(lhs,Binop::Minus(Node::new(start..end,())),rhs)),
  Factor,
  Access,
};

Factor: Box<Expr<'input>> =
{
  <lhs: Factor> <start: @L> "*" <end: @R> <rhs: Term> =>
  	Box::new(Expr::Binary(lhs,Binop::Times(Node::new(start..end,())),rhs)),
  <lhs: Factor> <start: @L> "/" <end: @R> <rhs: Term> =>
  	Box::new(Expr::Binary(lhs,Binop::Div(Node::new(start..end,())),rhs)),
  UnaryR,
};

Term: Box<Expr<'input>> =
{
  <val: Value> => Box::new(Expr::Val(val)),
  <start: @L> <id: "identifier"> <end: @R> =>
  	  Box::new(Expr::Id(Node::new(start..end,id))),
};

UnaryL: Box<Expr<'input>> =
{
  <start: @L> "*" <end: @R> <rhs: UnaryL> =>
      Box::new(Expr::Prefix(UnaryL::Deref(Node::new(start..end,())),rhs)),
  <start: @L> "&" <end: @R> <rhs: UnaryL> =>
      Box::new(Expr::Prefix(UnaryL::Ref(Node::new(start..end,())),rhs)),
  <start: @L> "-" <end: @R> <rhs: UnaryL> =>
      Box::new(Expr::Prefix(UnaryL::Minus(Node::new(start..end,())),rhs)),
  Call,
  Paren,
  Term,
};

UnaryR: Box<Expr<'input>> =
{
  <lhs: UnaryR> <start: @L> "!" <end: @R> =>
      Box::new(Expr::Postfix(lhs,UnaryR::Excl(Node::new(start..end,())))),
  UnaryL,
};

Access: Box<Expr<'input>> =
{
  <lhs: Expr> <start: @L> "." <end: @R> <rhs: Term> =>
  	Box::new(Expr::Binary(lhs,Binop::Access(Node::new(start..end,())),rhs)),
};

Paren: Box<Expr<'input>> =
{
   <start: @L> "(" <e: Expr> ")" <end: @R> => e,
};