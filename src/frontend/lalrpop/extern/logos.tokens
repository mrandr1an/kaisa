extern
{
  type Location = usize;
  type Error = LexerError;
  enum Token<'input> {
    "(" => Token::LPAREN,
    ")" => Token::RPAREN, 
    "[" => Token::LBRACK,
    "]" => Token::RBRACK,
    "'" => Token::SQUOTE,
    "," => Token::COMMA,
    "&" => Token::REF,
    "+" => Token::PLUS,
    "-" => Token::MINUS,
    "*" => Token::STAR,
    "/" => Token::RSLASH,
    "identifier" => Token::Identifier(<&'input str>),
    "defaultNum" => Token::DefaultNumber(<&'input str>),
    "charLit" => Token::CharacterLiteral(<&'input str>),
    "strLit" => Token::StringLiteral(<&'input str>),
  }
}