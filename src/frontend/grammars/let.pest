parameter =  {id ~ ":" ~ id}

let_function = { "fn" ~ id ~ parameter*  ~ "=" ~ operation}
let_variable = { "val" ~ parameter ~ "=" ~ operation}
let_type= { "type" ~ id ~ id* ~ "=" ~ operation}

assignment = { "let" ~ (let_function | let_variable | let_type) ~ ("in" ~  (operation | assignment))*  }

