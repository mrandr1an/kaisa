use std::str::FromStr;
use crate::frontend::ast::{Value,Expr,Node};
use crate::frontend::tokenizer::{LexerError,Token,KaisaLexer};

grammar<'input>(input: &'input str);

extern
{
  type Location = usize;
  type Error = LexerError;
  enum Token<'input> {
    "(" => Token::LPAREN,
    ")" => Token::RPAREN, 
    "[" => Token::LBRACK,
    "]" => Token::RBRACK,
    "'" => Token::SQUOTE,
    "," => Token::COMMA,
    "identifier" => Token::Identifier(<&'input str>),
    "defaultNum" => Token::DefaultNumber(<&'input str>),
    "charLit" => Token::CharacterLiteral(<&'input str>),
  }
}

pub Value: Value<'input> =
{
  <start: @L> <num:"defaultNum"> <end: @R>  =>
  	  Value::Number(Node::new(start..end,num)),
  <start: @L> <t: Tuple> <end: @R> =>
  	  Value::Tuple(Node::new(start..end,t)),
  <start: @L> <c: "charLit"> <end: @R> =>
  	  Value::Character(Node::new(start..end,c)),
  <start: @L> <l: List> <end: @R> =>
  	  Value::List(Node::new(start..end,l)),
  
};

Tuple: Box<[Box<Expr<'input>>]> = 
{
  "(" <i: Comma<Expr>> ")" => i,
};

List: Box<[Box<Expr<'input>>]> = 
{
  "[" <i: Comma<Expr>> "]" => i,
};

Comma<T>: Box<[T]> =
{
 <mut items:(<T> ",")*> <e:T?> => {
      match e
      {
        None => items.into_boxed_slice(),
	Some(e) => {
	  items.push(e);
	  items.into_boxed_slice()
	},
      }
 }
};